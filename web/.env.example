# Copy to .env.local for local work. Never commit .env.local.
#
# Addresses are optional: a build with none of them falls back to the record the
# deploy script wrote at deployments/sepolia.json, which vite.config.ts bundles.
# Set one only to point the app somewhere else than that record.

# Browser RPC (public, rate-limited). Not the SEPOLIA_RPC_URL deploy secret.
VITE_RPC_URL=
VITE_CHAIN_ID=11155111

# Product contracts. Empty = the bundled deployments/sepolia.json record.
VITE_LAUNCHPAD_ADDRESS=
VITE_LAUNCHPAD_DEPLOY_BLOCK=
VITE_HOOK_ADDRESS=
VITE_LOCKER_ADDRESS=

# Official Uniswap addresses. Empty = the pins in src/lib/cca/addresses.ts.
VITE_POOL_MANAGER=
VITE_LBP_STRATEGY=
VITE_POSITION_MANAGER=
VITE_UNIVERSAL_ROUTER=
VITE_CCA_LENS=

# Auction screen sections. Empty = on. Set to 0 to hide one.
VITE_CCA_MIGRATE=
VITE_CCA_SWAP=
VITE_CCA_COLLECT=

# ENS
VITE_PARENT_NAME=prophecy.eth
VITE_UNIVERSAL_RESOLVER=

# World ID. VITE_WORLD_MOCK must be 0 on anything recorded as evidence.
VITE_WORLD_MOCK=0
VITE_WORLD_SERVER_URL=
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=
VITE_WORLD_RP_ID=

VITE_WALLETCONNECT_PROJECT_ID=
