# Copy to a local .env (never commit real values).
# Web reads web/.env (VITE_*). Foundry reads contracts/.env.
# See docs/INFRA.md for who provides each value.

# --- web ---
VITE_RPC_URL=
VITE_LAUNCHPAD_ADDRESS=
VITE_PARENT_NAME=prophecy.eth
VITE_UNIVERSAL_RESOLVER=0x5d25c1d6acbb71b7a28aa7899618a3412a8303e3
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=
VITE_WORLD_RP_ID=
VITE_BASE=/

# --- contracts / Sepolia deploy (person only for broadcast) ---
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
TEAM_WALLET=
PROTOCOL_FEE_RECIPIENT=
WORLD_SIGNER=
UNISWAP_V4_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
HOOK_SALT=

# --- ENSv2 parent name (prophecy.eth) ---
PARENT_LABEL=prophecy
ENS_REGISTRATION_SECRET=
ENS_DURATION_SECONDS=31536000

# --- world verification server ---
WORLD_APP_ID=
WORLD_ACTION=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_SIGNER_KEY=
