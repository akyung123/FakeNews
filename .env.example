# Copy to a local .env (never commit real values).
# Infra owns this file. Other lanes list new names in their PR bodies.
# Web: web/.env (VITE_*). Foundry: contracts/.env. World: export names (no world/.env.example).
# See infra/README.md for who provides each value.

# --- web (RPC + contracts) ---
# Shipped to browsers. Use a public / rate-limited Sepolia endpoint — not the
# private deploy RPC stored as the SEPOLIA_RPC_URL Actions secret.
VITE_RPC_URL=
# After a send, copy `launchpad` from deployments/sepolia.json (anvil.json on a fork).
# `launchpadBlock` in that file is fromBlock for Launched — no extra VITE_* name.
VITE_LAUNCHPAD_ADDRESS=
# Default 11155111 (Sepolia). Pages preview reads this from Actions vars.
VITE_CHAIN_ID=11155111
VITE_HOOK_ADDRESS=
VITE_LOCKER_ADDRESS=
VITE_PARENT_NAME=prophecy.eth
VITE_UNIVERSAL_RESOLVER=0x5d25c1d6acbb71b7a28aa7899618a3412a8303e3
# Optional, public (PR #4). Empty is fine — Pages must not fail if unset.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BASE=/

# --- web (World ID / IDKit 4, PR #20) ---
# Mock is ON unless this is exactly 0 or false (isWorldMockEnabled). Preview/demo must use 0.
VITE_WORLD_MOCK=0
# Default http://localhost:8787 when mock is off. Pages preview reads Actions vars.
VITE_WORLD_SERVER_URL=http://localhost:8787
# Mock-mode defaults only. Real mode uses GET /rp-context from the world server.
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=
VITE_WORLD_RP_ID=

# --- contracts / Sepolia deploy (person only for sending) ---
# Deploy scripts and PR #19 Sepolia-fork lock tests both read this name.
# Keep this off the web bundle. Do not reuse it as VITE_RPC_URL.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Optional. Empty = deployer address. If set, must equal the deployer (one wallet).
TEAM_WALLET=
PROTOCOL_FEE_RECIPIENT=
WORLD_SIGNER_ADDRESS=
# Logged by Deploy.s.sol after it creates ProphecyEns. Optional override: if set,
# skip adapter CREATE and pass this address as Launchpad ens. Never 0 or 0xe05 off anvil.
ENS_ADAPTER_ADDRESS=
UNISWAP_V4_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
HOOK_SALT=

# --- ENSv2 parent name (prophecy.eth) ---
PARENT_LABEL=prophecy
ENS_REGISTRATION_SECRET=
ENS_DURATION_SECONDS=31536000
USER_REGISTRY_SALT=
PARENT_USER_REGISTRY=
LAUNCHPAD_ADDRESS=
# Optional. Empty = script mints 2x the ETHRegistrar fee (MockUSDC, 6 decimals).
MOCK_USDC_MINT_AMOUNT=

# --- world/ server (from PR #10; no world/.env.example) ---
# Required (user via lead, by 17:00 KST): WORLD_APP_ID, WORLD_ACTION, WORLD_RP_ID, WORLD_RP_SIGNING_KEY
WORLD_APP_ID=
WORLD_ACTION=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# Required — generated by infra at deploy (`infra/new-world-signer.sh`). NEVER commit.
# Same key the Launchpad constructor uses as worldSigner. Paste onto Render from local output only.
WORLD_SIGNER_KEY=
PORT=8787
# Optional
WORLD_ENVIRONMENT=
WORLD_PORTAL_URL=
# Mandatory after Launchpad deploy — paste onto Render and restart.
# Empty = server-side context check OFF (PR #16). Script prints both lines.
WORLD_CHAIN_ID=11155111
WORLD_LAUNCHPAD_ADDRESS=
